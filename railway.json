{
  "build": {
    "buildCommand": "echo 'Using Dockerfile'"
  },
  "deploy": {
    "startCommand": "node backend/server.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "dockerfile": "Dockerfile",
  "environments": {
    "production": {
      "envVars": [
        {
          "key": "NODE_ENV",
          "value": "production"
        },
        {
          "key": "PORT",
          "value": "3000"
        },
        {
          "key": "HOST",
          "value": "0.0.0.0"
        },
        {
          "key": "DATABASE_PATH",
          "value": "/app/database/uptime.db"
        },
        {
          "key": "CHECK_INTERVAL_MS",
          "value": "300000"
        },
        {
          "key": "REQUEST_TIMEOUT_MS",
          "value": "10000"
        },
        {
          "key": "ALLOW_PRIVATE_IPS",
          "value": "false"
        },
        {
          "key": "LOG_LEVEL",
          "value": "info"
        },
        {
          "key": "DISCORD_WEBHOOK_URL",
          "sync": false
        }
      ]
    }
  }
}